# ── Chat AI (Ollama) ────────────────────────────────────────────────────────
# Kosongkan OLLAMA_API_KEY = widget Chat AI bilang fiturnya belum aktif.
# Untuk Ollama lokal (OLLAMA_BASE_URL=http://localhost:11434) kunci tak perlu.
# TANPA awalan VITE_ — kunci ini hanya dibaca proxy Node, tidak ikut ke bundel.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_API_KEY=
OLLAMA_TIMEOUT_MS=
# Mesin pencari untuk tombol "Internet" di Chat AI (tanpa kunci).
# Kosong = lite.duckduckgo.com. Isi kalau alamat itu diblokir dari server.
AI_SEARCH_URL=

# ── Port ────────────────────────────────────────────────────────────────────
# Dibaca server.mjs (proses Node) DAN docker-compose.yml (pemetaan port, hanya
# ke 127.0.0.1). Satu nilai untuk keduanya, jadi tidak ada angka yang dipatok
# di Dockerfile/compose. Di server nilainya HARUS sama dengan port yang sudah
# ditunjuk proxy host hydroguard di nginx-proxy-manager, kalau tidak 502.
PORT=4021
